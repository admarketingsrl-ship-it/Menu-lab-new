rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Only allow operations scoped to a specific restaurant ID.
    // This forces the client to specify a restaurantId in their Firestore path.
    match /restaurants/{restaurantId}/{document=**} {
      allow read, write: if restaurantId != null;
    }
    
    // Block all other access by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
